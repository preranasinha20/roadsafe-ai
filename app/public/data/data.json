wn at the time; used for temporal flags."},{"feature":"Number_of_Vehicles","type":"int","pre":true,"used":true,"reason":"Known from the scene, capped at 6."},{"feature":"Latitude / longitude","type":"float","pre":true,"used":true,"reason":"Location of the accident."},{"feature":"h_* spatial history","type":"float","pre":true,"used":true,"reason":"Only uses accidents from earlier years, so no outcome of the row itself leaks in."}],"engineered":[{"group":"Time","items":["hour, month, weekday","is_weekend, is_rush_hour (07-09, 16-19)","is_night from light conditions","season","hour_sin / hour_cos (cyclical)"]},{"group":"Scene interactions","items":["dark_and_unlit","wet_surface and bad_weather","junction_at_night","high_speed_rural","speed_band (low / medium / high)"]},{"group":"Spatial history (leak-free)","items":["h_cell_n, h_cell_ksi_rate, h_cell_score","h_la_n, h_la_ksi_rate, h_la_score","h_dist_hotspot_m and h_in_hotspot","all from years strictly before the accident"]}],"splits":[{"name":"Train","years":"2006-2014","n":1441672,"use":"fit models (2005 only seeds history features)"},{"name":"Validation","years":"2015","n":140008,"use":"tuning, calibration, decision scales"},{"name":"Test","years":"2016-2017","n":266524,"use":"scored once at the end"}]}